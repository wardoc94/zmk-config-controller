#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &split_transform;
    };

    /*
     * Both halves share this same matrix wiring:
     *   Row 1 P1.04   Row 2 P1.06   Row 3 P0.10   Row 4 P0.09
     *   Col 1 P0.06   Col 2 P0.08   Col 3 P0.02   Col 4 P1.15   Col 5 P1.13   Col 6 P1.11
     *
     * Col 1/Col 2 were moved off P0.31/P0.29 onto P0.06/P0.08 - those two are
     * the nice!nano's only other free pins, needed to free up P0.31 (AIN7)
     * and P0.29 (AIN5) for the left half's TMR joystick, since P0.02/P0.29/
     * P0.31 are the ONLY ADC-capable pins actually broken out on this board
     * (P0.03/P0.04/P0.05/P0.28/P0.30 exist on the nRF52840 chip but aren't
     * exposed on the nice!nano's header).
     *
     * Assumed diode-direction: col2row (columns driven, rows read).
     * If your diodes are wired the other way, flip this to "row2col" and
     * swap which array gets the pull-down flag.
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpio0 6 GPIO_ACTIVE_HIGH>
            , <&gpio0 8 GPIO_ACTIVE_HIGH>
            , <&gpio0 2 GPIO_ACTIVE_HIGH>
            , <&gpio1 15 GPIO_ACTIVE_HIGH>
            , <&gpio1 13 GPIO_ACTIVE_HIGH>
            , <&gpio1 11 GPIO_ACTIVE_HIGH>
            ;
    };

    /*
     * Shared 48-position transform for the SPLIT build (left + right
     * together). Left uses this directly with no offset (its columns are
     * global columns 0-5). Right's overlay applies col-offset=6 to shift its
     * own raw columns 0-5 into global columns 6-11 - see the ZMK docs on
     * split matrix transforms for why this offset mechanism is required:
     * https://zmk.dev/docs/hardware-integration/new-shield#matrix-transform
     *
     * Layout: left's 24 matrix keys (row-major) + left's 4 joystick
     * positions (row 4), then right's 20 matrix keys (row-major, its
     * bottom two rows only have 4 keys each, at local cols 2-5 / global
     * cols 8-11). Total 28 + 20 = 48, matching the keymap's bindings order.
     *
     * NOT used by the standalone right build - that one has its own
     * separate, unshifted, 20-position transform since it's not combined
     * with anything.
     */
    split_transform: split_transform {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;

        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
RC(4,0) RC(4,1) RC(4,2) RC(4,3)

RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
                RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        >;
    };
};
