/*
 * Standalone build of the right half for testing on its own (matrix + PAW3395)
 * without needing the left half paired. Reuses the same matrix wiring and
 * sensor hardware as the split build, but has its OWN private, unshifted
 * transform (no col-offset, no combining with anything else) since this
 * shield never talks to a left half.
 */
#include "swiftpaw.dtsi"
#include "swiftpaw_right_hw.dtsi"

/*
 * Same reduced layout as the split right half: bottom two rows only have
 * keys at local cols 2-5 (2 leftmost keys removed on the physical PCB).
 * 6 + 6 + 4 + 4 = 20 keys, unshifted (col-offset stays at the default 0).
 */
/ {
    standalone_transform: standalone_transform {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <4>;

        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
                RC(2,2) RC(2,3) RC(2,4) RC(2,5)
                RC(3,2) RC(3,3) RC(3,4) RC(3,5)
        >;
    };

    chosen {
        zmk,matrix-transform = &standalone_transform;
    };
};
