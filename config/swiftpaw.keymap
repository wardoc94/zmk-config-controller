#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Left half: 24 matrix keys (4x6) + 4 joystick positions + 1 joystick
            // button = 29
            // Right half: 20 matrix keys (4x6, minus 2 leftmost keys on each of the
            // bottom two rows) = 20
            // Total: 49
            //
            // Joystick is multi-directional SCROLL (&msc) on this layer -
            // up/down/left/right map to scroll up/down/left/right. Scroll
            // step size set via ZMK_POINTING_DEFAULT_SCRL_VAL above.
            //
            // Two plain TOGGLE keys now (no more hold-tap): one for
            // lower_layer, one for bt_layer - tap either to enter, tap
            // again (bound at the same spot on that layer) to leave.
            //
            // FINNISH LAYOUT NOTE: ZMK keycodes are named after their US
            // keyboard POSITION, not the character they produce - the actual
            // character depends on your OS's active layout. Since you're on
            // Finnish:
            //   &kp FSLH -> types "-"  (Finnish's "-" lives where US has "/")
            //   &kp SQT  -> types "'"  (same physical spot on both layouts, unchanged)
            //
            // NOTE ON ORDERING: key "positions" in a combined split keymap are
            // assigned block-sequentially - all of the central half's positions,
            // in its own local matrix-transform order, THEN all of the
            // peripheral's. So this list is laid out as: all 29 left positions
            // first, then all 20 right positions.
            bindings = <
// --- Left half, row by row ---
&kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y
&kp A     &kp S     &kp D     &kp F     &kp G     &kp H
&kp Z     &kp X     &kp C     &kp V     &kp B     &kp N
&kp SPACE &kp LSHFT &kp LCTRL &kp LALT  &kp TAB   &kp ESC
// --- Left half joystick: columns are ordered by angle, clockwise starting
// from physical right (confirmed empirically: col0=right, col1=down;
// col2=left and col3=up are extrapolated from the same 90-degree clockwise
// spacing) ---
&msc SCRL_RIGHT &msc SCRL_DOWN &msc SCRL_LEFT &msc SCRL_UP
// --- Joystick button (P0.17) ---
&kp SPACE

// --- Right half, row by row (bottom two rows now start at col 2) ---
&mkp MB4  &mkp MB5  &kp U     &kp I     &kp O      &kp P
&mkp LCLK &mkp RCLK &kp J     &kp K     &kp L      &kp BSPC
                     &kp M    &kp COMMA &kp DOT    &kp RET
                     &kp FSLH &kp SQT   &tog 1     &tog 2
            >;
        };

        lower_layer {
            // FINNISH LAYOUT NOTE (continued):
            //   &kp MINUS     -> types "+"  (Finnish's "+" is where US has "-")
            //   &kp LS(EQUAL) -> types "`"  BUT this is a Finnish DEAD KEY
            //                    position (acute/grave accent key) - pressing
            //                    it may not immediately show a character until
            //                    you press another key (e.g. space) after it.
            //
            // NOTE: this row's toggle slot only has room for &tog 1 (to get
            // back to typing) - there's no spare slot here for a second
            // BT-layer toggle like default_layer has (this row is already
            // full with LEFT/DOWN/RIGHT). Use default_layer's &tog 2 to
            // reach bt_layer instead.
            bindings = <
// --- Left half ---
&kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6
&kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6
&kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp LS(EQUAL)
&kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
// Joystick as WASD on this layer (same clockwise column order as
// default_layer's scroll: col0=right, col1=down, col2=left, col3=up)
&kp D     &kp S     &kp A     &kp W
// --- Joystick button (P0.17) ---
&trans

// --- Right half ---
&mkp MB4  &mkp MB5  &kp TAB   &kp LALT  &kp PG_UP  &kp ESC
&mkp LCLK &mkp RCLK &kp LSHFT &kp LCTRL &kp PG_DN  &kp BSPC
                     &kp LGUI &kp UP    &kp DEL    &kp RET
                     &kp LEFT &kp DOWN  &kp RIGHT  &tog 1
            >;
        };

        bt_layer {
            // Entered/exited by tapping &tog 2 (on default_layer's right
            // bottom row) - a plain toggle now, no more hold-tap.
            bindings = <
// --- Left half: row0 BT profile select 0-3 + clear current + clear all
// (fits in one row of 6), row1 media transport + volume, row2 mute +
// brightness ---
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR &bt BT_CLR_ALL
&kp C_PREV   &kp C_PP     &kp C_NEXT   &kp C_STOP   &kp C_VOL_DN &kp C_VOL_UP
&kp C_MUTE   &kp C_BRI_DN &kp C_BRI_UP &trans       &trans       &trans
&trans       &trans       &trans       &trans       &trans       &trans
// --- Joystick on this layer: up/down = volume, left/right = track skip
// (col0=right, col1=down, col2=left, col3=up) ---
&kp C_NEXT &kp C_VOL_DN &kp C_PREV &kp C_VOL_UP
// --- Joystick button: play/pause ---
&kp C_PP

// --- Right half: force output to USB or BLE (for debugging - lets you
// keep USB plugged in for serial logs while HID output stays on BLE,
// since USB logging and HID output are separate USB interfaces) ---
&out OUT_USB &out OUT_BLE &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans
              &trans &trans &trans &trans
              &trans &trans &tog 1 &tog 2
            >;
        };
    };
};
